{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "FinalReport",
  "required": [
    "case_id",
    "analysis_status",
    "ar_presence",
    "probable_mechanism",
    "severity",
    "measurements",
    "trusted_metrics",
    "downweighted_metrics",
    "excluded_metrics",
    "discordances",
    "missing_information",
    "quality_summary",
    "recommendations",
    "guideline_provenance",
    "agent_results",
    "tool_versions",
    "audit_path",
    "research_use_only"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "analysis_status": {
      "type": "string",
      "enum": [
        "complete",
        "partial",
        "indeterminate"
      ]
    },
    "ar_presence": {
      "type": "string",
      "enum": [
        "present",
        "absent",
        "uncertain"
      ]
    },
    "probable_mechanism": {
      "type": "object",
      "required": [
        "label",
        "confidence",
        "limitations"
      ],
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string"
        },
        "confidence": {
          "type": "number"
        },
        "limitations": {
          "type": "array"
        }
      }
    },
    "severity": {
      "type": "object",
      "required": [
        "label",
        "confidence",
        "evidence_vector",
        "reasoning_summary"
      ],
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "trace",
            "mild",
            "moderate",
            "moderate_to_severe",
            "severe",
            "indeterminate"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        },
        "evidence_vector": {
          "type": "object"
        },
        "reasoning_summary": {
          "type": "array"
        }
      }
    },
    "measurements": {
      "type": "array"
    },
    "trusted_metrics": {
      "type": "array"
    },
    "downweighted_metrics": {
      "type": "array"
    },
    "excluded_metrics": {
      "type": "array"
    },
    "discordances": {
      "type": "array"
    },
    "missing_information": {
      "type": "array"
    },
    "quality_summary": {
      "type": "object"
    },
    "recommendations": {
      "type": "array"
    },
    "guideline_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_file",
          "section",
          "table_or_figure",
          "pages",
          "implementation_use"
        ],
        "additionalProperties": true,
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_file": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "table_or_figure": {
            "type": "string"
          },
          "pages": {
            "type": "array"
          },
          "implementation_use": {
            "type": "string"
          }
        }
      }
    },
    "agent_results": {
      "type": "array"
    },
    "tool_versions": {
      "type": "array"
    },
    "audit_path": {
      "type": "string"
    },
    "research_use_only": {
      "const": true
    }
  }
}
