{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "title": "FinalReport",
  "required": [
    "case_id",
    "analysis_status",
    "ar_presence",
    "probable_mechanism",
    "severity",
    "measurements",
    "trusted_metrics",
    "downweighted_metrics",
    "excluded_metrics",
    "discordances",
    "missing_information",
    "quality_summary",
    "recommendations",
    "guideline_provenance",
    "agent_results",
    "tool_versions",
    "audit_path",
    "artifact_index_path",
    "measurement_completeness",
    "research_use_only"
  ],
  "properties": {
    "case_id": {
      "type": "string"
    },
    "analysis_status": {
      "type": "string",
      "enum": [
        "complete"
      ]
    },
    "ar_presence": {
      "type": "string",
      "enum": [
        "present",
        "absent"
      ]
    },
    "probable_mechanism": {
      "type": "object",
      "required": [
        "label",
        "confidence",
        "limitations"
      ],
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string"
        },
        "confidence": {
          "type": "number"
        },
        "limitations": {
          "type": "array"
        }
      }
    },
    "severity": {
      "type": "object",
      "required": [
        "label",
        "confidence",
        "evidence_vector",
        "reasoning_summary"
      ],
      "additionalProperties": true,
      "properties": {
        "label": {
          "type": "string",
          "enum": [
            "trace",
            "mild",
            "moderate",
            "moderate_to_severe",
            "severe"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "moderate",
            "high"
          ]
        },
        "evidence_vector": {
          "type": "object"
        },
        "reasoning_summary": {
          "type": "array",
          "minItems": 1
        }
      }
    },
    "measurements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "measurement_id",
          "metric",
          "value",
          "unit",
          "selected_frames",
          "calibration_source",
          "formula",
          "ase_interpretation",
          "technical_validity",
          "artifact_paths",
          "quality_flags"
        ],
        "additionalProperties": true,
        "properties": {
          "measurement_id": {
            "type": "string"
          },
          "metric": {
            "type": "string"
          },
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "selected_frames": {
            "type": "array",
            "minItems": 1
          },
          "calibration_source": {
            "type": "string",
            "minLength": 1
          },
          "formula": {
            "type": "string",
            "minLength": 1
          },
          "ase_interpretation": {
            "type": "string",
            "minLength": 1
          },
          "technical_validity": {
            "type": "string",
            "enum": [
              "valid",
              "limited"
            ]
          },
          "artifact_paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "quality_flags": {
            "type": "array"
          }
        }
      }
    },
    "trusted_metrics": {
      "type": "array",
      "minItems": 1
    },
    "downweighted_metrics": {
      "type": "array"
    },
    "excluded_metrics": {
      "type": "array"
    },
    "discordances": {
      "type": "array"
    },
    "missing_information": {
      "type": "array",
      "maxItems": 0
    },
    "quality_summary": {
      "type": "object"
    },
    "recommendations": {
      "type": "array"
    },
    "guideline_provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_file",
          "section",
          "table_or_figure",
          "pages",
          "implementation_use"
        ],
        "additionalProperties": true,
        "properties": {
          "source_id": {
            "type": "string"
          },
          "source_file": {
            "type": "string"
          },
          "section": {
            "type": "string"
          },
          "table_or_figure": {
            "type": "string"
          },
          "pages": {
            "type": "array"
          },
          "implementation_use": {
            "type": "string"
          }
        }
      }
    },
    "agent_results": {
      "type": "array"
    },
    "tool_versions": {
      "type": "array"
    },
    "audit_path": {
      "type": "string"
    },
    "artifact_index_path": {
      "type": "string"
    },
    "measurement_completeness": {
      "type": "object",
      "required": [
        "required_metrics",
        "repair_history",
        "complete_exam_assumption"
      ],
      "additionalProperties": true,
      "properties": {
        "required_metrics": {
          "type": "array",
          "minItems": 1
        },
        "repair_history": {
          "type": "array"
        },
        "complete_exam_assumption": {
          "const": true
        }
      }
    },
    "research_use_only": {
      "const": true
    }
  }
}
